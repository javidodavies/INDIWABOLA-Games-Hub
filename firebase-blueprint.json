{
  "entities": {
    "PlayerPublic": {
      "title": "PlayerPublic",
      "description": "Publicly visible INDIWABOLA player profile and aggregated rankings without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "favoriteClub": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "country": {
          "type": "string",
          "enum": ["zambia", "all", "egypt", "england", "spain", "germany"]
        },
        "juniorMode": {
          "type": "boolean"
        },
        "streak": {
          "type": "integer"
        },
        "bestStreak": {
          "type": "integer"
        },
        "totalPoints": {
          "type": "integer"
        },
        "skillPoints": {
          "type": "integer"
        },
        "multiplayerPoints": {
          "type": "integer"
        },
        "gamesPlayed": {
          "type": "integer"
        },
        "wins": {
          "type": "integer"
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "favoriteClub",
        "country",
        "juniorMode",
        "streak",
        "bestStreak",
        "totalPoints",
        "skillPoints",
        "multiplayerPoints",
        "gamesPlayed",
        "wins",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlayerPrivate": {
      "title": "PlayerPrivate",
      "description": "Owner-only PII record containing verified email and preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "ScoreEntry": {
      "title": "ScoreEntry",
      "description": "Immutable match score record linked to an authenticated player.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "favoriteClub": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "gameId": {
          "type": "string",
          "enum": [
            "who-am-i",
            "bola-trivia",
            "predict-score",
            "bola-word",
            "mini-crossword",
            "bola-connections",
            "bola-strands",
            "bola-sudoku",
            "bola-tiles",
            "match-replay",
            "bola-draft",
            "memory-grid",
            "bola-letters",
            "bola-letter-box",
            "bola-ludo",
            "road-to-glory",
            "four-goals"
          ]
        },
        "category": {
          "type": "string",
          "enum": ["football", "multiplayer"]
        },
        "skillClass": {
          "type": "string",
          "enum": ["skill", "mixed"]
        },
        "region": {
          "type": "string",
          "enum": ["zambia", "all", "egypt", "england", "spain", "germany"]
        },
        "score": {
          "type": "integer"
        },
        "accuracy": {
          "type": "integer"
        },
        "attempts": {
          "type": "integer"
        },
        "isDaily": {
          "type": "boolean"
        },
        "lusakaDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "favoriteClub",
        "gameId",
        "category",
        "skillClass",
        "region",
        "score",
        "isDaily",
        "lusakaDate",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerPublic" },
      "description": "Publicly queryable player profile & leaderboard totals (no PII)."
    },
    "/players/{playerId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PlayerPrivate" },
      "description": "Owner-isolated PII document (verified email)."
    },
    "/players/{playerId}/scores/{scoreId}": {
      "schema": { "$ref": "#/entities/ScoreEntry" },
      "description": "Owner-scoped score history entries verified against parent player."
    }
  }
}
